<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows tray app (WPF, with WinForms only for NotifyIcon and its menu). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudeUsage</AssemblyName>
    <RootNamespace>ClaudeUsageTray</RootNamespace>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Claude Usage</Product>
    <AssemblyTitle>Claude Usage</AssemblyTitle>
    <Version>1.0.0</Version>
    <!-- Needed by the LibraryImport source generator for the Win32 calls in Native.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF0001: WPF's Fluent theme (ThemeMode) is still marked experimental.
         WFO0003: WinForms would rather set DPI awareness in code, but this is a WPF app, which reads it from app.manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share type names (Application, Button, ...): keep WinForms out of global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageCore\UsageCore.csproj" />
  </ItemGroup>

</Project>
