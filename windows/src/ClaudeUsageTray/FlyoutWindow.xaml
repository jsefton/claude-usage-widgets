<Window x:Class="ClaudeUsageTray.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeUsageTray"
        Title="Claude usage"
        Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        Background="{DynamicResource PanelBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource PanelBorder}" />
      <Setter Property="Margin" Value="0,12" />
    </Style>
    <!-- A flat, full-width row that toggles the settings. -->
    <Style x:Key="Disclosure" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,6" />
      <Setter Property="Margin" Value="-6,-4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverFill}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Border x:Name="Root"
          Background="{DynamicResource PanelBackground}"
          BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
      <StackPanel Margin="16,14,16,12" Typography.NumeralAlignment="Tabular">

        <!-- Header -->
        <TextBlock Text="Claude usage today" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="PeriodText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
        <TextBlock x:Name="NoLogsText" Style="{StaticResource Caption}" Margin="0,8,0,0"
                   Foreground="{DynamicResource StatusWarning}" Visibility="Collapsed"
                   Text="⚠ No Claude Code logs found. Set the data folder in Settings." />

        <TextBlock x:Name="LoadingText" Style="{StaticResource Caption}" Margin="0,12,0,0" Text="Loading…" />

        <StackPanel x:Name="UsageContent" Visibility="Collapsed">

          <!-- Today's cost against the daily budget -->
          <Grid Margin="0,10,0,6">
            <TextBlock x:Name="CostText" FontSize="30" FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Segoe UI" />
            <TextBlock x:Name="PercentText" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5" />
          </Grid>
          <local:Meter x:Name="BudgetMeter" />
          <TextBlock x:Name="BudgetText" Style="{StaticResource Caption}" Margin="0,6,0,0" />

          <!-- Usage as Claude reports it for the signed-in account -->
          <StackPanel x:Name="PlanSection">
            <Border Style="{StaticResource Divider}" />
            <TextBlock Text="Claude plan" Style="{StaticResource Caption}" Margin="0,0,0,8" />
            <StackPanel x:Name="PlanRows" />
            <TextBlock x:Name="PlanStatus" Style="{StaticResource Caption}" Visibility="Collapsed" />
          </StackPanel>

          <!-- Token counts -->
          <Border Style="{StaticResource Divider}" />
          <Grid x:Name="TokenGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
          </Grid>

          <!-- Cost per model -->
          <StackPanel x:Name="ModelSection">
            <Border Style="{StaticResource Divider}" />
            <TextBlock Text="By model" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <StackPanel x:Name="ModelRows" />
          </StackPanel>
        </StackPanel>

        <!-- Settings -->
        <Border Style="{StaticResource Divider}" />
        <!-- Not an Expander: its open/close animation fights the panel's resizing (as on macOS). -->
        <Button x:Name="SettingsToggle" Style="{StaticResource Disclosure}" AutomationProperties.Name="Settings">
          <DockPanel>
            <TextBlock x:Name="SettingsChevron" DockPanel.Dock="Right" VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Text="&#xE70D;" />
            <TextBlock Text="Settings" />
          </DockPanel>
        </Button>
        <local:SettingsPanel x:Name="SettingsView" Margin="0,8,0,0" Visibility="Collapsed" />

        <!-- Footer -->
        <Border Style="{StaticResource Divider}" />
        <DockPanel LastChildFill="True">
          <Button x:Name="QuitButton" DockPanel.Dock="Right" Content="Quit" Margin="6,0,0,0"
                  Style="{StaticResource FooterButton}" />
          <Button x:Name="RefreshButton" DockPanel.Dock="Right" ToolTip="Refresh now"
                  Style="{StaticResource FooterButton}"
                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Content="&#xE72C;" />
          <TextBlock x:Name="UpdatedText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
