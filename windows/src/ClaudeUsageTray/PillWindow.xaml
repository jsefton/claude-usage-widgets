<Window x:Class="ClaudeUsageTray.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude usage widget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True">
  <!-- The transparent margin leaves room for the shadow. -->
  <Border x:Name="Root" Margin="6" CornerRadius="13" Padding="10,4,12,5" MinHeight="26"
          Background="{DynamicResource PanelBackground}"
          BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
          ToolTip="Claude usage today. Click for details; drag to move.">
    <Border.Effect>
      <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Direction="270" Opacity="0.22" />
    </Border.Effect>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,7,0"
               Fill="{DynamicResource StatusGood}" />
      <TextBlock x:Name="LabelText" Text="Claude …" FontWeight="SemiBold" VerticalAlignment="Center"
                 Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimary}" />
    </StackPanel>
  </Border>
</Window>
