<UserControl x:Class="ClaudeUsageTray.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,4,12,4" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Daily budget ($)" Style="{StaticResource Label}" />
    <TextBox Grid.Row="0" Grid.Column="1" x:Name="BudgetBox" Width="96" HorizontalAlignment="Left"
             Margin="0,4" ToolTip="The amount that counts as 100%." />

    <TextBlock Grid.Row="1" Text="Day starts at" Style="{StaticResource Label}" />
    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ResetHourBox" Margin="0,4"
              ToolTip="The hour the daily total resets to zero." />

    <TextBlock Grid.Row="2" Text="Tray icon shows" Style="{StaticResource Label}" />
    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TrayShowsBox" Margin="0,4" />

    <TextBlock Grid.Row="3" Text="Widget shows" Style="{StaticResource Label}" />
    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="PillShowsBox" Margin="0,4" />

    <TextBlock Grid.Row="4" Text="Data folder" Style="{StaticResource Label}" />
    <TextBox Grid.Row="4" Grid.Column="1" x:Name="DataDirBox" Margin="0,4" />
    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,0,0,6"
               Text="Empty uses %USERPROFILE%\.claude. Separate several folders with commas." />

    <CheckBox Grid.Row="6" Grid.ColumnSpan="2" x:Name="ShowPillBox" Content="Show floating widget" Margin="0,2" />
    <CheckBox Grid.Row="7" Grid.ColumnSpan="2" x:Name="ShowPlanBox" Content="Show Claude plan usage" Margin="0,2"
              ToolTip="Reads Claude Code's login to fetch your monthly spend and plan limits from Claude." />
    <CheckBox Grid.Row="8" Grid.ColumnSpan="2" x:Name="LaunchAtLoginBox" Content="Launch at login" Margin="0,2" />
    <TextBlock Grid.Row="9" Grid.ColumnSpan="2" x:Name="LoginError" Style="{StaticResource Hint}"
               Foreground="{DynamicResource StatusCritical}" Visibility="Collapsed" />
  </Grid>
</UserControl>
